{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        // Declared so it is part of the cache key, not merely passed through.
        // `apps/www/next.config.ts` emits standalone output only when this is
        // unset (Docker) and omits it on Vercel, so the same inputs produce
        // genuinely different outputs — an artifact cached from one must never
        // be replayed for the other.
        "VERCEL",
        "CONVEX_DEPLOY_KEY",
        "CLERK_SECRET_KEY",
        "CLERK_JWT_ISSUER_DOMAIN",
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e-app#test": {
      // Not cached, and deliberately so. `e2e-app` does not depend on `app` in
      // the workspace graph, so its sources are not part of this task's hash —
      // a cached pass would be replayed unchanged after a UI regression. The
      // suite also drives the dev server from source, so it needs no upstream
      // build.
      "cache": false,
      "dependsOn": [],
      // Turbo 2 runs strict env mode: undeclared vars are not passed through.
      //
      // VITE_CONVEX_URL is NOT listed: playwright.config.ts sets it on the Vite
      // webServer itself, either to this run's local Convex backend or to a
      // placeholder, and inheriting a developer's value here would point the
      // suite at their cloud deployment. The E2E_*_PORT variables are not
      // listed either: each run allocates its own, which is what lets several
      // worktrees run the suite at once.
      //
      // E2E_CONVEX=0 drops the Convex backend and its specs (CI). CONVEX_URL
      // and SKIP_SEED_IMPORT are escape hatches documented in
      // apps/e2e-app/local-backend.ts and fixtures/global-setup.ts.
      "env": ["E2E_CONVEX", "CONVEX_URL", "SKIP_SEED_IMPORT"]
    },
    "e2e-www#test": {
      // Uncached for the same reason as e2e-app#test: `www` is not in this
      // task's hash. The Clerk and PostHog keys are deliberately not passed —
      // no spec may depend on them — and NEXT_PUBLIC_CONVEX_URL is not needed:
      // playwright.config.ts sets a placeholder, since nothing connects to it.
      "cache": false,
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
