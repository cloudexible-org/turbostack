{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CONVEX_DEPLOY_KEY",
        "CLERK_SECRET_KEY",
        "CLERK_JWT_ISSUER_DOMAIN",
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e#test": {
      // Not cached, and deliberately so. `e2e` does not depend on `app` in the
      // workspace graph, so apps/app's sources are not part of this task's hash
      // — a cached pass would be replayed unchanged after a UI regression. The
      // suite also drives its own Vite server from source, so it needs no
      // upstream build.
      "cache": false,
      "dependsOn": [],
      // Turbo 2 runs strict env mode: undeclared vars are not passed through,
      // and apps/app throws at startup without this one.
      "env": ["VITE_CONVEX_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
