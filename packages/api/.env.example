# ─── CLI-side: which deployment the Convex CLI talks to ──────────────────────
#
# Not a file you copy. This lives in Doppler's `turbostack` project, `dev_api`
# config, and the package scripts inject it with `doppler run` — `pnpm dev`, or
# `pnpm --filter @repo/api convex <args>` for any other CLI command.
#
# CONVEX_DEPLOY_KEY pins the CLI to the cloud dev deployment it was minted for
# and takes precedence over CONVEX_DEPLOYMENT, so no `npx convex login` is
# needed. The production key stays in Vercel, never here.
#
# A bare `npx convex …` skips Doppler and falls back to CONVEX_DEPLOYMENT in
# `.env.local` plus your login, if any. The Convex CLI writes that file itself,
# and the e2e harness snapshots and restores it — see docs/e2e-architecture.md.

CONVEX_DEPLOY_KEY=

# ─── Deployment-side: NOT set here ───────────────────────────────────────────
#
# Convex functions read `process.env` from the *deployment*, not from this file
# or Doppler (e.g. CLERK_JWT_ISSUER_DOMAIN). Set them in the Convex dashboard or
# with `pnpm --filter @repo/api convex env set`.
