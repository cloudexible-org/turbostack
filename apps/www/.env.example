# The variables in Doppler's `turbostack` project, `dev_www` config. Not a file
# you copy: the `dev` script runs under `doppler run`, which injects them, so
# there is no `.env.local` to keep. Keep this list in step with the config.
#
# Production values live in Vercel. The e2e suite sets its own
# NEXT_PUBLIC_CONVEX_URL.

NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostHog analytics (optional — analytics is skipped when the key is unset)
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
