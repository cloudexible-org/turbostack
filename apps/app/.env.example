# The variables in Doppler's `turbostack` project, `dev_app` config. Not a file
# you copy: the `dev` script runs under `doppler run`, which injects them, so
# there is no `.env.local` to keep. Keep this list in step with the config.
#
# Production values live in Vercel. The e2e suite sets its own VITE_CONVEX_URL.

VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# PostHog analytics (optional — analytics is skipped when the key is unset)
VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
