{
  "name": "turbostack",
  "version": "4.5.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install",
    "build": "turbo build",
    "dev": "turbo dev --ui tui",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test --filter=!e2e-*",
    "test:e2e": "turbo test --filter=e2e-*",
    "test:e2e:app": "turbo test --filter=e2e-app",
    "test:e2e:www": "turbo test --filter=e2e-www",
    "format": "biome format . --write",
    "check": "biome check .",
    "storybook": "pnpm --filter @repo/ui storybook",
    "setup:envs": "doppler setup --no-interactive"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "lefthook": "^2.1.14",
    "portless": "^0.15.6",
    "turbo": "latest",
    "turbo-ignore": "^2.11.2",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=26"
  }
}
